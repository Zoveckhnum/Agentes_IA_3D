# Para emuladores completos: npm run setup. Estos ejemplos son para Firebase real.
VITE_USE_EMULATORS=false

# Marca
VITE_APP_NAME=Stackbi Office
VITE_COMPANY_NAME=Mi empresa
VITE_BRAND_COLOR="#4700E0"
VITE_LOGO_URL=/logo.svg
VITE_APP_URL=http://127.0.0.1:5173

# Dueño de la cuenta (super admin)
VITE_SUPER_ADMIN_EMAIL=tu-correo@ejemplo.com

# Firebase: Consola de Firebase → Configuración del proyecto → Tus apps → App web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
