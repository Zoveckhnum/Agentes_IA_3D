{
  "hosting": {
    "public": "app/dist",
    "ignore": ["firebase.cloud.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [{ "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }]
  },
  "firestore": { "rules": ".local/firestore.cloud.rules" }
}
