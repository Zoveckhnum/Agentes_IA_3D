# motor/.env — lo genera npm run setup. NUNCA lo subas a GitHub (ya está en .gitignore).

# Para los valores demo completos: npm run setup. Este ejemplo usa Firebase real.
USE_EMULATORS=false

# OpenAI Codex: vacío reutiliza `npm run codex -- login`.
CODEX_MODEL=
CODEX_API_KEY=
# OPENAI_API_KEY también se acepta como alternativa.

# Usuario robot del motor (Firebase Authentication → correo/contraseña)
AGENT_EMAIL=tu-correo+agentes@gmail.com
AGENT_PASSWORD=PEGA_AQUI_LA_CONTRASENA

# Firebase (los mismos valores públicos de app/.env)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Telegram (opcional): bot creado con @BotFather y tu ID de usuario
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
